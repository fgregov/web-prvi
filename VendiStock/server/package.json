{
  "name": "@vendistock/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "user:create": "tsx src/cli/createUser.ts",
    "demo:seed": "tsx src/cli/seedDemo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^7.0.3",
    "dejavu-fonts-ttf": "^2.37.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "iconv-lite": "^0.7.3",
    "luxon": "^3.7.2",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.17.2",
    "pino": "^10.4.0",
    "playwright": "1.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "node-windows": "^1.0.0-beta.8"
  }
}
