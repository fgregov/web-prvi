# Renvara in the cloud: copy to deploy/.env on the server and fill in.
# Never commit deploy/.env (it is git-ignored). On Fly.io set the same values
# with `fly secrets set NAME=value` instead (deploy/README.md).

# The address people open (own server only: a DNS A/AAAA record of this name
# must point to the server before the first start).
RENVARA_DOMAIN=renvara.example.com

# The BETA account (checked on the server only; the password never reaches the browser).
RENVARA_BETA_USERNAME=
RENVARA_BETA_PASSWORD=
RENVARA_BETA_DISPLAY_NAME=

# Signs the session cookies. At least 32 characters, e.g.: openssl rand -base64 48
RENVARA_SESSION_SECRET=

# Organization time zone (dates, deadlines, Feedback Overview days).
RENVARA_ORG_TIMEZONE=Europe/Zagreb

# Push notifications (optional): all three or none. Generate once with
#   docker compose -f deploy/docker-compose.yml run --rm renvara node apps/beta-web/src/notifications/vapid-keys.ts
RENVARA_VAPID_PUBLIC_KEY=
RENVARA_VAPID_PRIVATE_KEY=
RENVARA_VAPID_SUBJECT=

# clean = start empty (real use), demo = start with the presentation demo records.
RENVARA_EDITION=clean
