{
  "name": "@renvara/beta-web",
  "version": "0.0.0",
  "private": true,
  "description": "Renvara BETA web app: single-user authentication backtest in front of the approved login and dashboard screens.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "demo:build": "node demo/build.ts",
    "demo:build:empty": "node demo/build.ts --empty",
    "demo:build:mobile": "node demo/build.ts --mobile",
    "demo:folder": "node demo/folder.ts",
    "localhost:build": "node localhost/build.ts",
    "push:keys": "node src/notifications/vapid-keys.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@renvara/domain": "workspace:*",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "rolldown": "1.2.12",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
