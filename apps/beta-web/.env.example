# Renvara BETA web — server-side configuration.
# Copy to .env (git-ignored) and fill in. Never commit real values.

# The single authorised BETA account (compared server-side, case-sensitive).
RENVARA_BETA_USERNAME=
RENVARA_BETA_PASSWORD=

# Secret used to sign session cookies. At least 32 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
RENVARA_SESSION_SECRET=

# Optional: name shown in the dashboard's account menu.
RENVARA_BETA_DISPLAY_NAME=Frane Gregov

# Optional: force the Secure cookie flag. Defaults to true when NODE_ENV=production.
# RENVARA_COOKIE_SECURE=true

# Optional: listen address (defaults: 127.0.0.1:3000; the Docker image uses 0.0.0.0).
# HOST=127.0.0.1
# PORT=3000

# Optional: exactly one reverse proxy in front (Caddy, Fly.io; set by deploy/):
# the failed-login limit then counts per client address from X-Forwarded-For.
# Leave unset when clients connect directly (a client could otherwise choose its address).
# RENVARA_TRUST_PROXY=true

# Optional CRM settings (defaults shown).
# RENVARA_BETA_ORG_ID=org-beta
# RENVARA_ORG_TIMEZONE=Europe/Zagreb
# RENVARA_DATA_FILE=.data/crm.json

# Optional: push reminders (tasks, leads, opportunities). All three, or none
# (none = reminders are saved but not delivered). Generate the keys once with:
#   pnpm --filter @renvara/beta-web push:keys
# Web Push needs HTTPS in production (localhost works for testing). On iPhone/iPad
# (iOS 16.4+) it works only after "Add to Home Screen".
# RENVARA_VAPID_PUBLIC_KEY=
# RENVARA_VAPID_PRIVATE_KEY=
# RENVARA_VAPID_SUBJECT=mailto:you@example.com

# Optional: the https address you open when the server runs behind an HTTPS
# tunnel or proxy (e.g. Tailscale Funnel, Cloudflare Tunnel) that changes the
# Host header. Only https:// and the host, no path.
# RENVARA_PUBLIC_ORIGIN=https://renvara.example.ts.net

# Optional: Follow-up Engine (offer PDFs and secret customer links, ADR-0008).
# Offer PDFs are stored privately in this folder (never served as public files).
# RENVARA_DOCUMENTS_DIR=.data/offer-documents
# Largest accepted PDF in MB (1–50).
# RENVARA_MAX_DOCUMENT_MB=20
# Days a customer link stays valid.
# RENVARA_SHARE_LINK_DAYS=90
# Days engagement events (link opened, offer viewed) are kept.
# RENVARA_EVENT_RETENTION_DAYS=365
# Key that seals the share tokens so a link can be copied again. At least 32
# characters; when unset it is derived from RENVARA_SESSION_SECRET. Changing it
# makes existing links impossible to show again (they keep working; issue new ones).
# RENVARA_SHARE_LINK_KEY=
# Customer links are built from RENVARA_PUBLIC_ORIGIN when set; use HTTPS in production.
