# Renvara BETA web — server-side configuration.
# Copy to .env (git-ignored) and fill in. Never commit real values.

# The single authorised BETA account (compared server-side, case-sensitive).
RENVARA_BETA_USERNAME=
RENVARA_BETA_PASSWORD=

# Secret used to sign session cookies. At least 32 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
RENVARA_SESSION_SECRET=

# Optional: name shown in the dashboard's account menu.
RENVARA_BETA_DISPLAY_NAME=Frane Gregov

# Optional: force the Secure cookie flag. Defaults to true when NODE_ENV=production.
# RENVARA_COOKIE_SECURE=true

# Optional: listen address (defaults: 127.0.0.1:3000).
# HOST=127.0.0.1
# PORT=3000

# Optional CRM settings (defaults shown).
# RENVARA_BETA_ORG_ID=org-beta
# RENVARA_ORG_TIMEZONE=Europe/Zagreb
# RENVARA_DATA_FILE=.data/crm.json

# Optional: push reminders (tasks, leads, opportunities). All three, or none
# (none = reminders are saved but not delivered). Generate the keys once with:
#   pnpm --filter @renvara/beta-web push:keys
# Web Push needs HTTPS in production (localhost works for testing). On iPhone/iPad
# (iOS 16.4+) it works only after "Add to Home Screen".
# RENVARA_VAPID_PUBLIC_KEY=
# RENVARA_VAPID_PRIVATE_KEY=
# RENVARA_VAPID_SUBJECT=mailto:you@example.com
